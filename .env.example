# Contact form (app/api/contact/route.ts).
# Without RESEND_API_KEY the endpoint returns a clear 503 and the form falls
# back to the mailto link, so the site is never silently dropping enquiries.
RESEND_API_KEY=
# Optional. A verified sender on your Resend account. Defaults to Resend's
# shared test sender, which is fine for a first deploy but will land in spam.
CONTACT_FROM="Portfolio <hi@abdullahsaleem.dev>"
